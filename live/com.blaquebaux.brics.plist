<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- brics Gulf EM diversifier. DRY-RUN by default until ~/.config/blaquebaux/alpaca_brics.env exists.
     Activate: cp to ~/Library/LaunchAgents/ and launchctl load. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.blaquebaux.brics</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/malcolmx/blaquebaux-brics/live/run_brics_daily.sh</string></array>
  <key>StartCalendarInterval</key><array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>32</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>42</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string></dict>
  <key>StandardOutPath</key><string>/Users/malcolmx/blaquebaux-brics/logs/launchd_brics.out</string>
  <key>StandardErrorPath</key><string>/Users/malcolmx/blaquebaux-brics/logs/launchd_brics.err</string>
</dict></plist>
